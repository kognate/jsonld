cabal-version:      2.2
name:               jsonld
version:            0.1.0.0
synopsis:           JSON-LD 1.1 processor for Haskell
description:
    A pure-Haskell implementation of the W3C JSON-LD 1.1 specification:
    expansion, compaction, flattening, RDF serialization/deserialization,
    framing, and RDF dataset canonicalization (RDFC-1.0).
    .
    This package is a work in progress. The current entry point is the
    W3C test-suite harness, which discovers every official test and reports
    its conformance status as the algorithms are filled in.
license:            BSD-3-Clause
author:             jsonld contributors
maintainer:         jsonld@example.invalid
category:           Data
build-type:         Simple
tested-with:        GHC == 9.6.6, GHC == 9.8.2, GHC == 9.10.1
extra-source-files:
    tests/json-ld-api/tests/*-manifest.jsonld
    tests/json-ld-framing/tests/*-manifest.jsonld

source-repository head
    type:     git
    location: https://github.com/kognate/jsonld

common warnings
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wincomplete-record-updates
        -Wincomplete-uni-patterns
        -Wmissing-export-lists
        -Wmissing-home-modules
        -Wpartial-fields
        -Wredundant-constraints

common deps
    build-depends:
          base              >= 4.18 && < 5
        , aeson             >= 2.1  && < 2.3
        , bytestring        >= 0.11 && < 0.13
        , containers        >= 0.6  && < 0.8
        , filepath          >= 1.4  && < 1.6
        , scientific        >= 0.3  && < 0.4
        , text              >= 2.0  && < 2.2
        , vector            >= 0.13 && < 0.14

library
    import:             warnings, deps
    default-language:   Haskell2010
    hs-source-dirs:     src
    exposed-modules:
        Data.JsonLd
        Data.JsonLd.Bridge
        Data.JsonLd.Error
        Data.JsonLd.Iri
        Data.JsonLd.Keyword
        Data.JsonLd.Types
        Data.JsonLd.Test.Manifest

test-suite jsonld-w3c
    import:             warnings, deps
    default-language:   Haskell2010
    type:               exitcode-stdio-1.0
    hs-source-dirs:     test
    main-is:            Main.hs
    other-modules:
        Test.JsonLd.BridgeSpec
        Test.JsonLd.IriSpec
        Test.JsonLd.KeywordSpec
        Test.JsonLd.W3C
    build-depends:
          jsonld
        , directory         >= 1.3  && < 1.4
        , tasty             >= 1.4  && < 1.6
        , tasty-hunit       >= 0.10 && < 0.11
